# Bu dosyayı .env adıyla kopyalayıp doldurun. .env git'e girmez.

# --llm gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# İsteğe bağlı: editör ya da özet için ayrı (ör. daha ucuz) model.
# Boş bırakılırsa yazarın modeli kullanılır. Özet basit iş, ucuz model yeter;
# editör ise ölçümlerin kaynağı, zayıf model ölçümü de zayıflatır.
# OZET_MODEL=gemini-3.1-flash-lite
# EDITOR_MODEL=

# --llm yerel  (OpenAI uyumlu sunucu: Ollama, vLLM, LM Studio...)
YEREL_LLM_URL=http://localhost:11434/v1
YEREL_LLM_MODEL=qwen2.5:7b-instruct
YEREL_LLM_ANAHTAR=
