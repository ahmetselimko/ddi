# Bu dosyayı .env adıyla kopyalayıp doldurun. .env git'e girmez.

# --llm gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# İsteğe bağlı: editör ya da özet için ayrı (ör. daha ucuz) model.
# Boş bırakılırsa yazarın modeli kullanılır. Özet basit iş, ucuz model yeter;
# editör ise ölçümlerin kaynağı, zayıf model ölçümü de zayıflatır.
# OZET_MODEL=gemini-3.1-flash-lite
# EDITOR_MODEL=

# --llm yerel  (OpenAI uyumlu sunucu: Ollama, vLLM, LM Studio...)
YEREL_LLM_URL=http://localhost:11434/v1
YEREL_LLM_MODEL=qwen2.5:7b-instruct
YEREL_LLM_ANAHTAR=

# Manga (isteğe bağlı, varsayılan kapalı). Görsel servisinin adresi ve anahtarı;
# üç kaynak da aynı HTTP arayüzünü kullanır (GET /saglik, POST /panel → PNG).
# Adresi boş olan kaynak arayüzde seçilemez. Uzak servislerde https kullan:
# anahtar her istekte gönderilir.
# MANGA_YEREL_ADRES=http://127.0.0.1:7860
# MANGA_YEREL_TOKEN=
# MANGA_RUNPOD_ADRES=
# MANGA_RUNPOD_TOKEN=
# MANGA_API_ADRES=
# MANGA_API_TOKEN=
# Balon yazı tipi (Türkçe harfleri olan bir .ttf); boşsa Comic Sans / Arial / DejaVu aranır.
# MANGA_FONT=
